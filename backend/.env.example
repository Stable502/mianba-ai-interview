# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=interview_ai

# ===== 应用配置 =====
# JWT 密钥（生产环境务必替换为随机字符串）
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 跨域允许的前端地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== DeepSeek LLM（用于面试评分 & 智能追问） =====
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 百度语音识别 ASR（用于前端录音转文字） =====
# 申请地址: https://console.bce.baidu.com/ → 人工智能 → 语音识别 → 创建应用
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
# dev_pid: 1537=普通话(纯中文), 1737=中英文混合, 1636=粤语
BAIDU_ASR_DEV_PID=1537
